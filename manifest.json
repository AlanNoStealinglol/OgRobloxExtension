{
  "manifest_version": 3,
  "name": "Roblox++",
  "version": "1.0",
  "description": "Changes Roblox To Look Better and OG!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.roblox.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab"]
} 